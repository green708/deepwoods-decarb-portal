# ─────────────────────────────────────────────────────────────────────────────
# platform/.env.example
#
# Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore — NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── GHG Apps Script integration ──────────────────────────────────────────────
# The URL of your deployed Google Apps Script web app (Code.gs).
# Required for the live reporting automation cycle (Day 0–8).
# Without this, the portal runs in demo mode — all uploads are simulated.
# See docs/DEPLOYMENT_GUIDE.md for setup instructions.
VITE_GHG_WEBAPP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# All other secrets (DB credentials, SMTP, Drive OAuth) live in
# backend/config.php (copied from backend/config.php.example).
# PHP config is server-side only and never exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────
